node_modules/
dist/
.wrangler/
.dev.vars
.env
.env.*
*.log
.DS_Store
.expo/

# Local agent scratch: screenshots and other debug artifacts.
.gg/
# One-off repro scripts. Debugging a spawn or a handshake wants a throwaway file
# at the repo root, and one has already been left behind once; the suffix makes
# that impossible rather than something to remember.
*.tmp.ts

# Code-signing material, listed before anyone has any.
#
# These arrive the first time you build for a store — often written into the
# project directory by a tool rather than by you — and a committed signing key
# cannot be un-leaked by deleting it later: it has to be revoked, and every build
# re-signed. In a public repo that is somebody impersonating your app.
*.p8
*.p12
*.pem
*.cer
*.certSigningRequest
*.mobileprovision
*.keystore
*.jks
credentials.json
google-services.json
GoogleService-Info.plist

# EAS writes local build state and credential caches here.
.eas/
# `eas metadata:pull` dumps a copy of the live App Store listing here whenever it
# runs. It is a download of what is already on Apple's servers; the file that is
# actually authored is `store.config.json` beside it.
packages/app/store/

# Notes the agents write for themselves.
#
# pew2 hands every agent a working directory, and an agent is free to keep state
# there — this one turned up at the repo root the first time an agent was booted
# from it. Those files belong to whoever ran the agent, not to this repo.
memories.json
