{
  "$schema": "../schemas/provider.schema.json",
  "id": "github-copilot",
  "name": "GitHub Copilot CLI",
  "version": "1.0.0",
  "description": "GitHub's AI pair programmer, in ACP mode. Requires a Copilot subscription.",
  "distribution": {
    "type": "npx",
    "package": "@github/copilot",
    "version": "latest",
    "args": [
      "--acp"
    ]
  },
  "repository": "https://github.com/github/copilot-cli",
  "authors": [
    "GitHub"
  ],
  "license": "proprietary",
  "pew": {
    "transport": "acp",
    "color": "#a371f7"
  }
}
