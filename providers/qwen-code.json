{
  "$schema": "../schemas/provider.schema.json",
  "id": "qwen-code",
  "name": "Qwen Code",
  "version": "1.0.0",
  "description": "Alibaba's Qwen coding assistant, in ACP mode.",
  "distribution": {
    "type": "npx",
    "package": "@qwen-code/qwen-code",
