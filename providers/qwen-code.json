      "--acp",
      "--experimental-skills"
    ]
  },
  "repository": "https://github.com/QwenLM/qwen-code",
  "authors": [
    "Alibaba"
  ],
  "license": "Apache-2.0",
  "pew": {
    "transport": "acp",
    "color": "#615ced"
  }
}
