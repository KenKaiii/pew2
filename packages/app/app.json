{
  "expo": {
    "name": "pew2",
    "slug": "pew2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.pew2.app"
    },
    "android": {
      "package": "dev.pew2.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Used only to scan the pairing code shown on your computer.",
          "recordAudioAndroid": false
        }
      ],
      "expo-font",
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Used only to save images your agent sends you.",
          "photosPermission": "Used only to save images your agent sends you.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
